# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# Get your DeepSeek API key here: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OPTIONAL: DeepSeek OpenAI-compatible Base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPTIONAL: DeepSeek model. Recommended for editor AI: deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-v4-flash

# Required for signing backend auth cookies in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# OPTIONAL: Vercel Blob (for uploading images)
# Get your Vercel Blob credentials here: https://vercel.com/docs/storage/vercel-blob/quickstart#quickstart
BLOB_READ_WRITE_TOKEN=

# OPTIONAL: Vercel KV (for ratelimiting)
# Get your Vercel KV credentials here: https://vercel.com/docs/storage/vercel-kv/quickstart#quickstart
KV_REST_API_URL=
KV_REST_API_TOKEN=

# OPTIONAL: Enterprise RAG backend. Keep RAG_ENGINE=local to use the browser fallback.
# Set RAG_ENGINE=qdrant or RAG_ENGINE=pgvector to enable LangChain.js backend retrieval.
RAG_ENGINE=local
RAG_TOP_K=6

# OpenAI-compatible embedding endpoint. Default example uses Alibaba Cloud Model Studio / DashScope.
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v4
# text-embedding-v4 supports 2048, 1536, 1024, 768, 512, 256, 128, and 64. Default is 1024.
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BATCH_SIZE=16

# Qdrant provider config
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docflow_knowledge

# pgvector provider config
PGVECTOR_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/docflow
PGVECTOR_TABLE=docflow_rag_chunks
PGVECTOR_COLLECTION=docflow_knowledge
